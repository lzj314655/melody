# ===== DeepSeek（对话大模型，必填）=====
# 注册 https://platform.deepseek.com 获取 API Key 后粘贴到这里
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# ===== 商城 Spring Boot 后端 =====
BACKEND_URL=http://localhost:8080

# ===== AI 服务自身 =====
PORT=8100
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ===== MySQL（与商城同库；聊天记录表 t_chat_session / t_chat_message）=====
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=123456
DB_NAME=melody_shop

# ===== RAG 向量检索 =====
# 向量模型：BAAI/bge-small-zh-v1.5 int8 量化 ONNX（自动从 hf-mirror 下载到 data/embed-model/，约24MB，离线运行）
KB_TOP_K=3

# ===== Agent =====
CONTEXT_WINDOW=20
MAX_TOOL_ROUNDS=8
SESSION_KEEP_MESSAGES=500

# ===== 售后多 Agent（LangGraph）=====
# 与 Spring Boot 的 app.after-sale.internal-token 保持一致；为空则内部接口不可用
AFTER_SALE_ENABLED=true
AFTER_SALE_INTERNAL_TOKEN=
AFTER_SALE_KB_TOP_K=3

# ===== 冒烟测试账号（scripts/smoke_test.py 用，不影响服务）=====
SMOKE_PHONE=13800138001
SMOKE_PASSWORD=password
