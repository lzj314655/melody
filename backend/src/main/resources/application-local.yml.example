# 复制为 application-local.yml 后填写（application-local.yml 已被 .gitignore 排除）
#   copy src\main\resources\application-local.yml.example src\main\resources\application-local.yml
spring:
  datasource:
    # 本地 MySQL root 密码
    password: "123456"

# JWT 签名密钥：至少 32 字节的随机字符串（可用 openssl rand -base64 36 生成）
melody:
  jwt:
    secret: "please-change-me-to-a-random-32-plus-char-string"

# 支付宝沙箱（open.alipay.com → 沙箱控制台）
alipay:
  appId: ""
  privateKey: ""
  publicKey: ""
