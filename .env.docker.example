# ================================================================
# 麦乐迪 Docker 部署环境变量（复制为 .env.docker 后填写）
#   cp .env.docker.example .env.docker
# 注意：.env.docker 含密钥，已被 .gitignore 忽略，勿提交
# ================================================================

# MySQL root 密码（容器库）
MYSQL_ROOT_PASSWORD=123456

# DeepSeek API Key（AI 助手必填，https://platform.deepseek.com 获取）
DEEPSEEK_API_KEY=

# 支付宝沙箱（应用私钥/支付宝公钥，从 open.alipay.com 沙箱控制台获取；本地裸机放 application-local.yml）
ALIPAY_APP_ID=
ALIPAY_PRIVATE_KEY=
ALIPAY_PUBLIC_KEY=

# DeepSeek 接口地址（一般不用改）
DEEPSEEK_BASE_URL=https://api.deepseek.com
