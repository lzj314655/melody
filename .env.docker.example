# ================================================================
# 麦乐迪 Docker 部署环境变量（复制为 .env.docker 后填写）
#   cp .env.docker.example .env.docker
# 注意：.env.docker 含密钥，已被 .gitignore 忽略，勿提交
# ================================================================

# MySQL root 密码（容器库）
MYSQL_ROOT_PASSWORD=123456

# JWT 签名密钥（必填，至少 32 位随机字符串；可用 `openssl rand -base64 36` 生成）
JWT_SECRET=please-change-me-to-a-random-32-plus-char-string

# Python 售后 Agent 调用 Java 内部接口的共享令牌（必填，随机字符串）
AFTER_SALE_INTERNAL_TOKEN=please-change-me-to-a-random-internal-token

# DeepSeek API Key（AI 助手必填，https://platform.deepseek.com 获取）
DEEPSEEK_API_KEY=

# 支付宝沙箱（应用私钥/支付宝公钥，从 open.alipay.com 沙箱控制台获取；本地裸机放 application-local.yml）
ALIPAY_APP_ID=
ALIPAY_PRIVATE_KEY=
ALIPAY_PUBLIC_KEY=

# DeepSeek 接口地址（一般不用改）
DEEPSEEK_BASE_URL=https://api.deepseek.com
